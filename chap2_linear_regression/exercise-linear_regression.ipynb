为了让您能够选择不同的优化方法，我在 `main` 函数中添加了一个 `optimizer` 参数，并默认使用最小二乘法（填空顺序 1）。在代码中，我用注释将两种方法隔开。

### 补全后的代码

```python
import numpy as np
import matplotlib.pyplot as plt

def load_data(filename):
    """载入数据。"""
    xys = []
    with open(filename, 'r') as f:
        for line in f:
            xys.append(map(float, line.strip().split()))
        xs, ys = zip(*xys)
        return np.asarray(xs), np.asarray(ys)

## 不同的基函数 (basis function)的实现 填空顺序 2

# 请分别在这里实现“多项式基函数”以及“高斯基函数”

# 其中以及训练集的x的范围在0-25之间

def identity_basis(x):
    ret = np.expand_dims(x, axis=1)
    return ret

def multinomial_basis(x, feature_num=10):
    '''多项式基函数'''
    x = np.expand_dims(x, axis=1) # shape(N, 1)
    #==========
    #todo '''请实现多项式基函数'''
    #==========
    # 多项式基函数：[x^1, x^2, ..., x^M]
    # N是样本数，M是feature_num (基函数的数量)
    ret = np.power(x, np.arange(1, feature_num + 1)) # shape(N, feature_num)
    return ret

def gaussian_basis(x, feature_num=10):
    '''高斯基函数'''
    #==========
    #todo '''请实现高斯基函数'''
    #==========
    # 假设x的范围在0-25之间
    # 均匀分布的均值 mu，以及固定的宽度 sigma
    
    x = np.expand_dims(x, axis=1) # shape(N, 1)
    
    # 1. 确定高斯函数的中心 mu (均匀分布在0到25之间)
    # 2. 确定高斯函数的宽度 sigma
    mu = np.linspace(0, 25, feature_num) # shape(feature_num,)
    # 假设使用一个固定的宽度，例如 (25 / feature_num)
    sigma = 25.0 / feature_num
    
    # 广播计算 (x - mu)^2 / (2 * sigma^2)
    # x - mu: (N, 1) - (feature_num,) -> (N, feature_num)
    diff = x - mu
    # -0.5 * (diff / sigma)**2
    exponent = -0.5 * (diff / sigma)**2
    
    # 高斯基函数: exp(-(x - mu)^2 / (2 * sigma^2))
    ret = np.exp(exponent) # shape(N, feature_num)
    return ret

## 返回一个训练好的模型 填空顺序 1 用最小二乘法进行模型优化 
## 填空顺序 3 用梯度下降进行模型优化

def main(x_train, y_train, basis_func=identity_basis, feature_num=1, optimizer='least_square'):
    """
    训练模型，并返回从x到y的映射。
    basis_func: 基函数 (identity_basis, multinomial_basis, gaussian_basis)
    feature_num: 基函数的数量 (对于identity_basis无效)
    optimizer: 'least_square' 或 'gradient_descent'
    """
    
    # 构造设计矩阵 Phi
    phi0 = np.expand_dims(np.ones_like(x_train), axis=1) # 偏置项 w0 对应的基函数 phi_0(x)=1
    
    # 如果是identity_basis，则只需要一列x，且feature_num无效
    if basis_func == identity_basis:
        phi1 = basis_func(x_train) # shape(N, 1)
    else:
        # 使用多项式或高斯基函数
        phi1 = basis_func(x_train, feature_num=feature_num) # shape(N, feature_num)
        
    phi = np.concatenate([phi0, phi1], axis=1) # shape(N, 1 + feature_num)
    
    
    #==========
    #todo '''计算出一个优化后的w，请分别使用最小二乘法以及梯度下降两种办法优化w'''
    #==========
    
    # 初始化权重 w (维度: 1 + feature_num)
    w_dim = phi.shape[1]
    w = np.zeros(w_dim)
    
    if optimizer == 'least_square':
        ### 填空顺序 1：最小二乘法 (解析解)
        
        # 最小二乘法的公式: w = (Phi^T * Phi)^-1 * Phi^T * y
        # 1. 计算 (Phi^T * Phi)
        Phi_T = phi.T
        Phi_T_Phi = np.dot(Phi_T, phi)
        
        # 2. 计算 (Phi^T * y)
        Phi_T_y = np.dot(Phi_T, y_train)
        
        # 3. 计算 w
        w = np.dot(np.linalg.inv(Phi_T_Phi), Phi_T_y)
        
    elif optimizer == 'gradient_descent':
        ### 填空顺序 3：梯度下降法
        
        # 参数设置
        learning_rate = 0.0001 # 学习率，需要根据数据和基函数调整
        num_iterations = 10000 # 迭代次数
        N = x_train.shape[0]   # 样本数量
        
        # 初始化权重 w
        w = np.random.randn(w_dim) # 使用随机初始化
        
        for i in range(num_iterations):
            # 预测值 y_pred = Phi * w
            y_pred = np.dot(phi, w)
            
            # 误差 E = y_pred - y_train
            error = y_pred - y_train
            
            # 梯度 grad = (1/N) * Phi^T * error (最小化平方误差 L2 loss)
            # 或者 grad = Phi^T * error (不除以N，仅影响学习率)
            grad = np.dot(phi.T, error) / N
            
            # 更新权重 w = w - learning_rate * grad
            w = w - learning_rate * grad
        
    else:
        raise ValueError("Unknown optimizer. Choose 'least_square' or 'gradient_descent'.")


    def f(x):
        # 根据训练时使用的基函数和特征数量，重新构造 Phi
        phi0 = np.expand_dims(np.ones_like(x), axis=1)
        
        if basis_func == identity_basis:
            phi1 = basis_func(x)
        else:
            phi1 = basis_func(x, feature_num=feature_num)
            
        phi = np.concatenate([phi0, phi1], axis=1)
        
        y = np.dot(phi, w)
        return y

    return f

## 评估结果 

def evaluate(ys, ys_pred):
    """评估模型。"""
    std = np.sqrt(np.mean(np.abs(ys - ys_pred) ** 2))
    return std

# 程序主入口（建议不要改动以下函数的接口）
if __name__ == '__main__':
    train_file = 'train.txt'
    test_file = 'test.txt'
    # 载入数据
    x_train, y_train = load_data(train_file)
    x_test, y_test = load_data(test_file)
    print(x_train.shape)
    print(x_test.shape)

    # =======================================================
    # **请在这里修改参数以测试不同的基函数和优化器**
    #
    # 示例 1: 使用 多项式基函数， feature_num=10， 最小二乘法
    # f = main(x_train, y_train, basis_func=multinomial_basis, feature_num=10, optimizer='least_square')
    #
    # 示例 2: 使用 高斯基函数， feature_num=10， 梯度下降法
    # f = main(x_train, y_train, basis_func=gaussian_basis, feature_num=10, optimizer='gradient_descent')
    #
    # 默认 (线性回归): identity_basis (相当于多项式基函数 feature_num=1), 最小二乘法
    f = main(x_train, y_train, basis_func=identity_basis, feature_num=1, optimizer='least_square')
    # =======================================================

    y_train_pred = f(x_train)
    std = evaluate(y_train, y_train_pred)
    print('训练集预测值与真实值的标准差：{:.1f}'.format(std))
    
    # 计算预测的输出值
    y_test_pred = f(x_test)
    # 使用测试集评估模型
    std = evaluate(y_test, y_test_pred)
    print('预测值与真实值的标准差：{:.1f}'.format(std))

    #显示结果
    plt.plot(x_train, y_train, 'ro', markersize=3)
#     plt.plot(x_test, y_test, 'k') # 实际测试集数据，可取消注释查看
    plt.plot(x_test, y_test_pred, 'k')
    plt.xlabel('x')
    plt.ylabel('y')
    plt.title('Linear Regression')
    plt.legend(['train', 'pred'])
    plt.show()

